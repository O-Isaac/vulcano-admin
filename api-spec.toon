components:
  schemas:
    RecursoUpdateRequest:
      type: object
      properties:
        nombre:
          type: string
        desc:
          type: string
        rareza:
          type: string
    RecursoResponse:
      type: object
      properties:
        id:
          type: integer
          format: int32
        nombre:
          type: string
        desc:
          type: string
        rareza:
          type: string
    PlanoCreateRequest:
      type: object
      properties:
        coste:
          type: integer
          format: int64
        desc:
          type: string
          minLength: 1
        nombre:
          type: string
          minLength: 1
        tiempoConstrucion:
          type: integer
          format: int64
        recursoFabricadoId:
          type: integer
          format: int32
      required: items[5]:
          - coste
          - desc
          - nombre
          - recursoFabricadoId
          - tiempoConstrucion
    ComponenteResponse:
      type: object
      properties:
        id:
          type: integer
          format: int32
        cantidad:
          type: integer
          format: int32
        recurso:
          $ref: #/components/schemas/RecursoResponse
    PlanoResponse:
      type: object
      properties:
        id:
          type: integer
          format: int32
        coste:
          type: integer
          format: int64
        desc:
          type: string
        nombre:
          type: string
        tiempoConstrucion:
          type: integer
          format: int64
        recursoFabricado:
          $ref: #/components/schemas/RecursoResponse
        componentes:
          type: array
          items:
            $ref: #/components/schemas/ComponenteResponse
    InventarioResponse:
      type: object
      properties:
        recurso:
          $ref: #/components/schemas/RecursoResponse
        jugador:
          $ref: #/components/schemas/JugadorResponse
        cantidad:
          type: integer
          format: int32
    JugadorResponse:
      type: object
      properties:
        id:
          type: integer
          format: int32
        nivel:
          type: integer
          format: int32
        correo:
          type: string
        creditos:
          type: integer
          format: int64
        role:
          type: string
    ComponenteCreateRequest:
      type: object
      properties:
        cantidad:
          type: integer
          format: int32
        recursoId:
          type: integer
          format: int32
      required: items[2]:
          - cantidad
          - recursoId
    RecursoCreateRequest:
      type: object
      properties:
        nombre:
          type: string
          minLength: 1
        desc:
          type: string
          maxLength: 50
          minLength: 10
        rareza:
          type: string
          minLength: 1
          pattern: (COMUN|RARO|LEGENDARIO)
      required: items[3]:
          - desc
          - nombre
          - rareza
    QueueCreateRequest:
      type: object
      properties:
        planoId:
          type: integer
          format: int32
      required: items[1]:
          - planoId
    QueueResponse:
      type: object
      properties:
        id:
          type: integer
          format: int32
        inicioTime:
          type: string
          format: date-time
        finalTime:
          type: string
          format: date-time
        estado:
          type: string
        jugador:
          $ref: #/components/schemas/JugadorResponse
        plano:
          $ref: #/components/schemas/PlanoResponse
    InventarioResponsePrivado:
      type: object
      properties:
        recurso:
          $ref: #/components/schemas/RecursoResponse
        cantidad:
          type: integer
          format: int32
    RegisterRequest:
      type: object
      properties:
        username:
          type: string
          format: email
          minLength: 1
        password:
          type: string
          maxLength: 2147483647
          minLength: 8
        secondPassword:
          type: string
          minLength: 1
      required: items[3]:
          - password
          - secondPassword
          - username
    LoginRequest:
      type: object
      properties:
        password:
          type: string
          minLength: 1
        username:
          type: string
          format: email
          minLength: 1
      required: items[2]:
          - password
          - username
    PageRecursoResponse:
      type: object
      properties:
        totalElements:
          type: integer
          format: int64
        totalPages:
          type: integer
          format: int32
        size:
          type: integer
          format: int32
        content:
          type: array
          items:
            $ref: #/components/schemas/RecursoResponse
        number:
          type: integer
          format: int32
        first:
          type: boolean
        last:
          type: boolean
        sort:
          $ref: #/components/schemas/SortObject
        numberOfElements:
          type: integer
          format: int32
        pageable:
          $ref: #/components/schemas/PageableObject
        empty:
          type: boolean
    PageableObject:
      type: object
      properties:
        offset:
          type: integer
          format: int64
        sort:
          $ref: #/components/schemas/SortObject
        paged:
          type: boolean
        pageSize:
          type: integer
          format: int32
        pageNumber:
          type: integer
          format: int32
        unpaged:
          type: boolean
    SortObject:
      type: object
      properties:
        empty:
          type: boolean
        sorted:
          type: boolean
        unsorted:
          type: boolean
