            schema:
              $ref: #/components/schemas/RegisterRequest
        required: true
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                type: object
                additionalProperties:
  /api/auth/refresh:
    post:
      tags: items[1]:
