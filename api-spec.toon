    patch:
      tags: items[1]:
          - jugadore-controller
      operationId: addCreditos
      parameters: items[2]:
          - name: cantidad
          in: path
          required: true
          schema:
            type: integer
            format: int64
          - name: jugadorId
          in: path
          required: true
          schema:
            type: integer
            format: int32
      responses:
        200:
          description: OK
          content:
            */*:
              schema:
                $ref: #/components/schemas/JugadorResponse
